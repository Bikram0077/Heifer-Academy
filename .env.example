# ==============================================================================
# Heifer Academy — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# Do NOT commit private keys, service account credentials, or secrets to Git.
#
# Client variables must be prefixed with VITE_ to be exposed to Vite bundles.
# ==============================================================================

# Public Firebase Web Client Configuration
VITE_FIREBASE_API_KEY=AIzaSyB...
VITE_FIREBASE_AUTH_DOMAIN=heifer-academy-cms.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=heifer-academy-cms
VITE_FIREBASE_STORAGE_BUCKET=heifer-academy-cms.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=485439700475
VITE_FIREBASE_APP_ID=1:485439700475:web:04802c79a47cfe09f7df5e

# Optional Custom Ports
PORT=8443
ADMIN_PORT=5174

# Firebase App Check (Denial of Wallet / DDoS Mitigation)
# Register your domain in Firebase Console -> App Check -> reCAPTCHA Enterprise
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Optional debug token for local development / CI
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=true

