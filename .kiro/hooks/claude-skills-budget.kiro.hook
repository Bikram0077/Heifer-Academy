{
  "name": "Claude Skills — budget watch",
  "description": "Managed by Claude Skills Manager (claude-skills-budget)",
  "version": "1",
  "enabled": true,
  "when": {
    "type": "promptSubmit"
  },
  "then": {
    "type": "runCommand",
    "command": "curl -sf -X POST -H \"Content-Type: application/json\" --data @- \"http://127.0.0.1:4895/hook/budget?agent=kiro&cwd=c%3A%5CUsers%5Cbdham%5CDownloads%5CDesign%20Heifer%20Academy%20Learning%20Platform\" || true",
    "timeout": 8
  }
}
